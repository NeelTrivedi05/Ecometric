# EcoMetric Frontend Environment Configuration

# Backend API URL:
# - Local dev: leave empty or set to http://localhost:8000 (Vite dev server proxies /api to port 8000)
# - Production on Vercel: set to your deployed backend URL (e.g. https://ecometric-api.onrender.com)
VITE_API_URL=http://localhost:8000

# Supabase Authentication & Storage:
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
