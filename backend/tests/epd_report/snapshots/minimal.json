   {
    "blocks": [
     {
      "anchor": "sub-assumptions",
      "kind": "heading",
      "level": 2,
      "number": "5.1",
      "text": "Assumptions",
      "toc": true
     },
     {
      "html": false,
      "kind": "paragraph",
      "style": "body",
      "text": "The selection of secondary datasets to represent the supply chain is a significant value choice; no generic dataset is a perfect fit. Supply-chain-specific data would improve the accuracy of the results."
     },
     {
      "anchor": "sub-limitations",
      "kind": "heading",
      "level": 2,
      "number": "5.2",
      "text": "Limitations",
      "toc": true
     },
     {
      "html": false,
      "kind": "paragraph",
      "style": "body",
      "text": "Results represent potential environmental impacts and do not predict impacts on specific endpoints, the exceedance of thresholds, safety margins or risks."
     },
     {
      "html": false,
      "kind": "paragraph",
      "style": "body",
      "text": "Environmental declarations from different programs (ISO 14025) may not be comparable. Results are only comparable when the same functional or declared unit, PCR, system boundary and calculation rules apply."
     }
    ],
