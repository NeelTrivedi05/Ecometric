# EcoMetric Backend Environment Variables Example
DATABASE_URL=sqlite:///../database/prisma/dev.db
SECRET_KEY=ecometric_super_secret_jwt_signing_key_change_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# File Sealing & Cryptographic Provenance
FILE_SEALING_ENABLED=true
VERIFY_BASE_URL=http://localhost:5173/verify
VERIFY_IP_HASH_SALT=ecometric_salt_for_ip_hashing_dev_only
SEAL_ACTIVE_SIGNING_KEY_ID=k1
# Example test signing key (Ed25519 DER PKCS8 base64) - replace in production!
SEAL_SIGNING_KEY_k1=MC4CAQAwBQYDK2VwBCIEIKxU+9o9F4e9Qn4b9e2+7sK3e4b7x9x+2e1y9z+4a5b6
SEAL_ACTIVE_KEK_ID=kek1
# Example test KEK (AES-256 32-byte key base64) - replace in production!
SEAL_KEK_kek1=YWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWFhYWE=

# ecoinvent LCIA database (Supabase Postgres). Use the Session pooler URI
# (Supabase -> Connect -> Session pooler); the direct db.*.supabase.co host is IPv6-only.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
